+                             [=](sycl::nd_item<1> item_ct1) {
+                                 router_gather_kernel(probs_d, ids_d, gr_d, n_experts, n_rows, n_expert_used);
+                                 GGML_UNUSED(item_ct1);
+                             });
+    }
