+static bool ggml_sycl_router_sigmoid_add_enabled() {
+    static const bool disabled = []() {
+        const char * env = getenv("GGML_SYCL_DISABLE_ROUTER_SIGMOID_ADD");
+        return env != nullptr && std::atoi(env) != 0;
+    }();
+    return !disabled;
