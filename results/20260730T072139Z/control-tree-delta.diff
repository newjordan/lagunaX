+    if (mode == 5) {
+        // Stock through DIV (incl. sum/clamp/div); fuse SCALE only as x*s+b.
+        GGML_ASSERT(ggml_sycl_compute_forward(ctx, getrows_node));
+        ggml_tensor * scale_node = nullptr;
+        for (int j = 6; j < nops; ++j) {
+            ggml_tensor * t = cgraph->nodes[i + j];
+            if (!t) {
