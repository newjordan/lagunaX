+            ggml_tensor * t = cgraph->nodes[i + j];
+            if (!t || t->op == GGML_OP_NONE || t->op == GGML_OP_RESHAPE || t->op == GGML_OP_VIEW ||
+                t->op == GGML_OP_PERMUTE || t->op == GGML_OP_TRANSPOSE || ggml_is_empty(t)) {
+                continue;
+            }
+            GGML_ASSERT(ggml_sycl_compute_forward(ctx, t));
+        }
+        return;
+    }
