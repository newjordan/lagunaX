+    if (ne10 != gate_w->ne[0] || ne10 != up_w->ne[0] || ne10 % QK8_1 != 0) return false;
+    if (gate_w->ne[1] != up_w->ne[1] || gate_w->ne[2] != up_w->ne[2]) return false;
