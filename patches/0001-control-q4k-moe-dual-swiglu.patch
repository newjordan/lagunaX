+    const uintptr_t a0 = reinterpret_cast<uintptr_t>(a->data);
+    const uintptr_t b0 = reinterpret_cast<uintptr_t>(b->data);
+    const uintptr_t a1 = a0 + (uintptr_t) ggml_nbytes(a);
