+        if (!g_ggml_sycl_enable_optimize || !ctx.opt_feature.reorder) {
+            return false;
+        }
+        if (!ggml_sycl_supports_reorder_mmvq(w->type)) {
+            return false;
+        }
+        ggml_tensor_extra_gpu * extra = static_cast<ggml_tensor_extra_gpu *>(w->extra);
