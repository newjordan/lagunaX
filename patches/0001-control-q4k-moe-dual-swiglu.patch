+        bool ok = true;
+        for (int k = 0; k < 3; ++k) {
+            if (idx + k >= cgraph->n_nodes || cgraph->nodes[idx + k]->op != norm_ops[k] ||
+                cgraph->nodes[idx + k]->src[0] != cgraph->nodes[idx + k - 1]) {
