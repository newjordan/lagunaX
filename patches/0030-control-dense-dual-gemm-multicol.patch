+                    "[lx-control-moe-dual] multi-token expert-batched dual GEMM "
+                    "n_tokens=%" PRId64 " k=%" PRId64 " n_experts=%" PRId64 "\n",
+                    ne12, n_ids, n_as);
+        }
+    }
+    return true;
+}
