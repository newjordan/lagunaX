+
+        // Swiglu into gate_contiguous slice (overwrite gate values).
+        const int64_t nelt = num_src1_rows * ne0;
+        const float * gd = (const float *) (gate_contiguous.get() + expert_row_offset * nb1);
+        const float * ud = (const float *) (up_contiguous.get() + expert_row_offset * nb1);
+        float *       dd = (float *) (gate_contiguous.get() + expert_row_offset * nb1);
