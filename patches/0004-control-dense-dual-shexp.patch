+        const int     nb = (total + BS - 1) / BS;
+        stream->parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) nb * BS), sycl::range<1>(BS)),
+                             [=](sycl::nd_item<1> item_ct1) {
