+// Bitexact aim: sequential sum of k (matches left-fold better than tree reduce for k=8),
+// true div, then scale s*x+b. Also writes raw gather into getrows_buf when non-null
+// (keeps intermediate buffer valid if allocator aliases / consumers exist).
+static void router_gather_norm_kernel(const float * __restrict__ probs, const int32_t * __restrict__ ids_full,
+                                      float * __restrict__ getrows_buf, float * __restrict__ weights,
+                                      const int n_experts, const int n_rows, const int n_expert_used,
+                                      const float clamp_min, const float scale_val, const float scale_bias,
+                                      const bool with_norm) {
+    auto      item_ct1 = sycl::ext::oneapi::this_work_item::get_nd_item<1>();
+    const int row      = item_ct1.get_group(0);
+    if (row >= n_rows) {
+        return;
+    }
+    const int lane = item_ct1.get_local_id(0);
+
+    const float *   probs_row = probs + (size_t) n_experts * row;
+    const int32_t * ids_row   = ids_full + (size_t) n_experts * row;
+    float *         gr_row    = getrows_buf ? getrows_buf + (size_t) n_expert_used * row : nullptr;
+    float *         w_row     = weights + (size_t) n_expert_used * row;
