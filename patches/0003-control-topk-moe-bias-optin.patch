+// Bias path: bitonic argsort on selection scores (same network as ggml_sycl k_argsort DESC).
 template <int n_experts>
-static void launch_topk_moe(queue_ptr stream, const float * logits, float * weights, int32_t * ids, int n_rows,
-                            int n_expert_used, float clamp_val, float scale_val, const topk_moe_config & config) {
+static void topk_moe_kernel_bias_bitonic(const float * __restrict__ logits,
+                                         float * __restrict__       weights,
+                                         int32_t * __restrict__     ids,
+                                         const float * __restrict__ bias,
+                                         const int                  n_rows,
+                                         const int                  n_expert_used,
+                                         const float                clamp_val,
+                                         const float                scale_val,
+                                         const topk_moe_config       config,
+                                         float * __restrict__       sh_wt,
+                                         float * __restrict__       sh_sel,
+                                         int * __restrict__         sh_idx) {
+    static_assert(n_experts >= WARP_SIZE && (n_experts % WARP_SIZE) == 0, "n_experts must be multiple of WARP_SIZE");
+    auto      item_ct1 = sycl::ext::oneapi::this_work_item::get_nd_item<1>();
+    const int row       = item_ct1.get_group(0);
+    if (row >= n_rows) {
+        return;
+    }
+    const int lane = item_ct1.get_local_id(0);
+    constexpr int ept = n_experts / WARP_SIZE;
+
+    logits  += (size_t) n_experts * row;
+    weights += (size_t) n_expert_used * row;
+    ids     += (size_t) n_experts * row;
+
+    // Load logits -> activation into shared wt; selection = wt + bias.
+#pragma unroll
+    for (int t = 0; t < ept; ++t) {
+        const int expert = t * WARP_SIZE + lane;
+        float     v      = logits[expert];
+        sh_wt[expert]    = v;
+    }
+    item_ct1.barrier(sycl::access::fence_space::local_space);
+
+    // Apply sigmoid/softmax across experts in shared memory via registers.
+    float wt_reg[ept];
+#pragma unroll
+    for (int t = 0; t < ept; ++t) {
+        wt_reg[t] = sh_wt[t * WARP_SIZE + lane];
+    }
+    if (!config.delayed_softmax) {
+        if (config.use_sigmoid) {
+            sigmoid_warp_inplace<ept, false>(wt_reg, n_experts, lane);
+        } else {
+            softmax_warp_inplace<ept, false>(wt_reg, n_experts, lane);
+        }
+    }
+#pragma unroll
+    for (int t = 0; t < ept; ++t) {
+        if (sycl::isnan(wt_reg[t])) {
+            wt_reg[t] = -FLT_MAX;
+        }
+        const int expert = t * WARP_SIZE + lane;
+        sh_wt[expert]    = wt_reg[t];
+        sh_sel[expert]   = wt_reg[t] + bias[expert];
+        sh_idx[expert]   = expert;
+    }
+    item_ct1.barrier(sycl::access::fence_space::local_space);
+
+    // Bitonic sort indices by sh_sel DESC — mirrors k_argsort_f32_i32 (DESC branch).
+    for (int k = 2; k <= n_experts; k *= 2) {
+        for (int j = k / 2; j > 0; j /= 2) {
+#pragma unroll
+            for (int t = 0; t < ept; ++t) {
+                const int col = t * WARP_SIZE + lane;
+                const int ixj = col ^ j;
+                if (ixj > col) {
+                    if ((col & k) == 0) {
+                        if (sh_sel[sh_idx[col]] < sh_sel[sh_idx[ixj]]) {
+                            topk_swap(sh_idx[col], sh_idx[ixj]);
+                        }
+                    } else {
+                        if (sh_sel[sh_idx[col]] > sh_sel[sh_idx[ixj]]) {
+                            topk_swap(sh_idx[col], sh_idx[ixj]);
+                        }
+                    }
+                }
+            }
+            item_ct1.barrier(sycl::access::fence_space::local_space);
+        }
+    }
+
+    // Top-k ids + unbiased weights; optional norm over selected.
+    float wt_sum = 0.f;
+#pragma unroll
+    for (int t = 0; t < ept; ++t) {
+        const int k = t * WARP_SIZE + lane;
+        if (k < n_expert_used) {
+            const int expert = sh_idx[k];
+            ids[k]           = expert;
+            const float w    = sh_wt[expert];
+            // stash in sh_sel[k] temporarily for reduction
+            sh_sel[k] = w;
+            if (config.with_norm) {
+                wt_sum += w;
+            }
+        }
+    }
+    item_ct1.barrier(sycl::access::fence_space::local_space);
+
+    if (config.with_norm) {
+        // reduce wt_sum across warp (only first n_expert_used lanes contribute)
+        wt_sum = warp_reduce_sum<WARP_SIZE>(wt_sum);
+        // lanes beyond used still participate with 0 contribution from above if k>=used
+        wt_sum          = sycl::fmax(wt_sum, clamp_val);
+        const float inv = 1.0f / wt_sum;
+#pragma unroll
+        for (int t = 0; t < ept; ++t) {
+            const int k = t * WARP_SIZE + lane;
+            if (k < n_expert_used) {
+                weights[k] = sh_sel[k] * inv * scale_val;
+            }
+        }
+    } else {
+#pragma unroll
+        for (int t = 0; t < ept; ++t) {
+            const int k = t * WARP_SIZE + lane;
+            if (k < n_expert_used) {
+                weights[k] = sh_sel[k] * scale_val;
+            }
+        }
+    }
+}
