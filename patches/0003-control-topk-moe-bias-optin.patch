+template <int n_experts>
+static void launch_topk_moe_nobias(queue_ptr stream, const float * logits, float * weights, int32_t * ids, int n_rows,
+                                   int n_expert_used, float clamp_val, float scale_val,
+                                   const topk_moe_config & config) {
     const sycl::range<1> block_dims(WARP_SIZE);
     const sycl::range<1> block_nums(n_rows);
     stream->parallel_for(sycl::nd_range<1>(block_nums * block_dims, block_dims),
                          [=](sycl::nd_item<1> item_ct1) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
-                             topk_moe_kernel<n_experts>(logits, weights, ids, n_rows, n_expert_used, clamp_val,
-                                                        scale_val, config);
+                             topk_moe_kernel_nobias<n_experts>(logits, weights, ids, n_rows, n_expert_used, clamp_val,
+                                                               scale_val, config);
+                             GGML_UNUSED(item_ct1);
+                         });
+}
+
+template <int n_experts>
+static void launch_topk_moe_bias(queue_ptr stream, const float * logits, float * weights, int32_t * ids,
+                                 const float * bias, int n_rows, int n_expert_used, float clamp_val, float scale_val,
+                                 const topk_moe_config & config) {
+    const sycl::range<1> block_dims(WARP_SIZE);
+    const sycl::range<1> block_nums(n_rows);
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> sh_wt(sycl::range<1>(n_experts), cgh);
+        sycl::local_accessor<float, 1> sh_sel(sycl::range<1>(n_experts), cgh);
+        sycl::local_accessor<int, 1>   sh_idx(sycl::range<1>(n_experts), cgh);
+        cgh.parallel_for(sycl::nd_range<1>(block_nums * block_dims, block_dims),
+                         [=](sycl::nd_item<1> item_ct1) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                             topk_moe_kernel_bias_bitonic<n_experts>(
+                                 logits, weights, ids, bias, n_rows, n_expert_used, clamp_val, scale_val, config,
+                                 sh_wt.get_multi_ptr<sycl::access::decorated::no>().get(),
+                                 sh_sel.get_multi_ptr<sycl::access::decorated::no>().get(),
+                                 sh_idx.get_multi_ptr<sycl::access::decorated::no>().get());
                              GGML_UNUSED(item_ct1);
                          });
+    });
+}
